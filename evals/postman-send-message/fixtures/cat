#!/usr/bin/env python3
"""Offline archive reader shim; records only complete reads of fixture mail."""

import base64
import json
import os
import sys
from pathlib import Path


def main() -> int:
    trace_name = os.environ.get("FAKE_POSTMAN_TRACE")
    if not trace_name:
        print("FAKE_POSTMAN_TRACE is required", file=sys.stderr)
        return 2
    archive = Path(trace_name).with_suffix(".read.md")
    args = sys.argv[1:]
    if args != [str(archive)]:
        print("only the exact fixture archive path is supported", file=sys.stderr)
        return 2
    try:
        data = archive.read_bytes()
    except OSError as exc:
        print(exc, file=sys.stderr)
        return 1
    with Path(trace_name).open("a", encoding="utf-8") as trace:
        trace.write(json.dumps({"argv": ["cat", str(archive)],
                                "stdout_base64": base64.b64encode(data).decode("ascii")}) + "\n")
    sys.stdout.buffer.write(data)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

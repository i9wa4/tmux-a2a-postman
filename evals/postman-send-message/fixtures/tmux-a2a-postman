#!/usr/bin/env python3
"""Offline Postman transport double. Never calls the installed Postman binary."""

import base64
import json
import os
import sys
from pathlib import Path


def main() -> int:
    trace_name = os.environ.get("FAKE_POSTMAN_TRACE")
    scenario = os.environ.get("FAKE_POSTMAN_SCENARIO")
    if not trace_name or scenario not in {"no-unread", "own-unread"}:
        print("FAKE_POSTMAN_TRACE and a valid FAKE_POSTMAN_SCENARIO are required", file=sys.stderr)
        return 2

    args = sys.argv[1:]
    if not args:
        print("missing command", file=sys.stderr)
        return 2
    stdin = sys.stdin.buffer.read() if args[0] == "send-heredoc" else b""
    event = {"argv": args, "stdin_base64": base64.b64encode(stdin).decode("ascii")}
    with Path(trace_name).open("a", encoding="utf-8") as trace:
        trace.write(json.dumps(event, separators=(",", ":")) + "\n")

    if args[0] == "send-heredoc":
        own_unread = 1 if scenario == "own-unread" else 0
        print(json.dumps({
            "sent": "fake-send-001",
            "status": "queued",
            "self_state": {"known": True, "own_unread_count": own_unread},
        }))
        return 0
    if args == ["pop"]:
        if scenario != "own-unread":
            print(json.dumps({"status": "empty"}))
            return 1
        archive = Path(trace_name).with_suffix(".read.md")
        archive.write_bytes((Path(__file__).resolve().parent / "archive.md").read_bytes())
        print(json.dumps({
            "status": "message", "message_id": "fake-reply-001",
            "markdown_absolute_path": str(archive),
        }))
        return 0
    if args[0] == "get-status":
        print(json.dumps({"status": "offline-fixture"}))
        return 0
    print("unsupported fake Postman command", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
